{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@core/*": ["./src/@core/*"],
      "dao": ["./src/dao"],
      "config": ["./src/config"],
      "service/*": ["./src/service/*"],
      "controller/*": ["./src/controller/*"]
    },
    "noImplicitAny": false,
    "types": ["bun-types"]
  }
}
